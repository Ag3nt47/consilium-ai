#!/bin/sh
# Consilium pre-commit check. Several AIs commit to this repo from one shared working tree, so a
# commit can easily pick up (or miss) someone else's half-finished lines. This checks exactly what
# is staged, not the working tree: it exports the index to a temporary folder and type-checks and
# tests that copy, so a commit that would not build on GitHub is refused here.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Skip in an emergency:   git commit --no-verify
set -e
root=$(git rev-parse --show-toplevel)
cd "$root"

node scripts/check-secrets.mjs --staged

changed=$(git diff --cached --name-only --diff-filter=ACMRD)
case "$changed" in
  *src/*|*tests/*|*tsconfig.json*|*package.json*|*vite.config.ts*) ;;
  *) exit 0 ;;
esac
# Only the Rust side changed below this point? Leave that to cargo and GitHub's checks.
echo "$changed" | grep -qvE '^src-tauri/' || exit 0

snap=$(mktemp -d "${TMPDIR:-/tmp}/consilium-precommit.XXXXXX")
junction=
cleanup() {
  # Remove a Windows junction by itself first, so rm -rf can never walk into the shared node_modules.
  if [ -n "$junction" ]; then
    if ! cmd //c rmdir "$junction" >/dev/null 2>&1; then
      echo "pre-commit: could not remove the node_modules junction; leaving $snap in place so rm -rf can't reach the shared node_modules." >&2
      return 0
    fi
  fi
  rm -rf "$snap"
}
trap cleanup EXIT INT TERM
git checkout-index -a --prefix="$snap/"
# A fresh `git worktree add` has no node_modules of its own: borrow the main checkout's.
modules="$root/node_modules"
if [ ! -d "$modules" ]; then
  modules="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")/node_modules"
fi
if [ ! -d "$modules/typescript" ]; then
  echo "pre-commit: no node_modules in $root or the main checkout. Run npm ci first." >&2
  exit 1
fi
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    # Without Developer Mode, Git Bash's ln -s copies instead of linking; a junction links on any Windows.
    # //J, not /J: Git Bash rewrites a lone /J into a POSIX path before cmd sees it.
    link=$(cygpath -w "$snap/node_modules")
    cmd //c mklink //J "$link" "$(cygpath -w "$modules")" >/dev/null
    junction=$link
    ;;
  *) ln -s "$modules" "$snap/node_modules" ;;
esac
# Git sets these for hooks. Left in place, a test that runs `git init` in a scratch folder would
# re-initialise this repository instead, and switch core.bare on.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX GIT_COMMON_DIR GIT_OBJECT_DIRECTORY
cd "$snap"
if ! npm ls --depth=0 >"$snap/npm-ls.log" 2>&1; then
  cat "$snap/npm-ls.log" >&2
  echo "pre-commit: the dependency check (npm ls) failed for $modules, which may come from another revision. Run npm ci in $root." >&2
  exit 1
fi
if ! node node_modules/typescript/bin/tsc --noEmit -p .; then
  echo "pre-commit: the staged screen code does not type-check (see above). Stage the missing files, or unstage the unfinished ones." >&2
  exit 1
fi
if ! node --test "tests/*.test.mjs" >"$snap/test-output.log" 2>&1; then
  cat "$snap/test-output.log" >&2
  echo "pre-commit: the staged tests fail (see above)." >&2
  exit 1
fi
