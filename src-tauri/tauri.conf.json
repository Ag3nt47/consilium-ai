{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Consilium",
  "version": "0.1.0",
  "identifier": "io.github.ag3nt47.consilium",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Consilium",
        "width": 1240,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A council of minds",
    "longDescription": "Consilium puts several AI assistants and you in one conversation. ChatGPT and Claude take part through their official command-line tools, using your own sign-ins.",
    "copyright": "Copyright (c) 2026 Consilium contributors",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
